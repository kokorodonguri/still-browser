<Window x:Class="LightweightBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="SF Pro Text, Segoe UI" Title="Still" Width="1440" Height="900" MinWidth="732" MinHeight="500"
        Background="{StaticResource CanvasBrush}" Foreground="#F5F5F7" WindowStartupLocation="CenterScreen">
  <Grid x:Name="RootLayout">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Background="{StaticResource CanvasBrush}">
      <Grid Margin="8,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SidebarButton" Width="36" Height="32" Padding="8" ToolTip="Tabs" AutomationProperties.Name="Show tabs" Click="Sidebar_Click"><Path Data="M1,1 L17,1 17,15 1,15 Z M6,1 L6,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Stretch="Uniform" Width="16" Height="14"/></Button>
          <Button x:Name="BackButton" Content="←" Width="36" Height="32" Padding="6" IsEnabled="False" ToolTip="Back" AutomationProperties.Name="Back" Click="Back_Click"/>
          <Button x:Name="ForwardButton" Content="→" Width="36" Height="32" Padding="6" IsEnabled="False" ToolTip="Forward" AutomationProperties.Name="Forward" Click="Forward_Click"/>
          <Grid Width="36"><Button x:Name="ReloadButton" Content="↻" Height="32" Padding="6" ToolTip="Reload" AutomationProperties.Name="Reload" Click="Reload_Click"/><ProgressBar x:Name="LoadingIndicator" Visibility="Collapsed" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" AutomationProperties.Name="Loading page"/></Grid>
        </StackPanel>
        <Border Grid.Column="1" Background="#2C2C2E" CornerRadius="8" Height="32" Margin="12,0" BorderThickness="1">
          <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#14FFFFFF"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></Style.Triggers></Style></Border.Style>
          <Grid Margin="12,0">
            <TextBlock Text="Search Google or enter an address" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="13"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=AddressBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <TextBox x:Name="AddressBox" FontSize="13" AutomationProperties.Name="Search Google or enter an address" ToolTip="Search Google or enter an address (Ctrl+L)" KeyDown="AddressBox_KeyDown"/>
          </Grid>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ActiveDownloadsButton" Visibility="Collapsed" Content="↓" Padding="8,4" Height="32" ToolTip="Downloads in progress" AutomationProperties.Name="Downloads in progress" Click="Downloads_Click"/>
          <Button x:Name="NewTabButton" Content="+" FontSize="20" Width="36" Height="32" Padding="6" ToolTip="New tab (Ctrl+T)" AutomationProperties.Name="New tab" Click="NewTab_Click"/>
          <Button x:Name="MenuButton" Content="⋯" FontSize="20" Width="36" Height="32" Padding="6" ToolTip="Menu" AutomationProperties.Name="Menu" Click="Menu_Click">
            <Button.ContextMenu><ContextMenu Background="#2C2C2E" Foreground="#F5F5F7">
              <MenuItem Header="Tabs" Click="Sidebar_Click"/>
              <Separator/>
              <MenuItem x:Name="BookmarkButton" Header="Bookmark this page" IsEnabled="False" Click="BookmarkCurrent_Click"/>
              <MenuItem Header="Bookmarks" Click="Bookmarks_Click"/>
              <MenuItem Header="History" Click="History_Click"/>
              <MenuItem Header="Downloads" Click="Downloads_Click"/>
            </ContextMenu></Button.ContextMenu>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="SidebarPanel" Visibility="Collapsed" Background="{StaticResource SidebarBrush}" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0" Padding="8,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TabList"/></ScrollViewer>
      </Border>
      <Border Grid.Column="1" CornerRadius="12" Margin="8" BorderBrush="#14FFFFFF" BorderThickness="1"><Grid x:Name="ContentHost" Background="{StaticResource CanvasBrush}"/></Border>
    </Grid>
    <Popup x:Name="NoticePopup" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
      <Border Background="#2C2C2E" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" MaxWidth="400">
        <DockPanel><Button DockPanel.Dock="Right" Content="×" Padding="8,4" ToolTip="Dismiss notification" AutomationProperties.Name="Dismiss notification" Click="DismissNotice_Click"/><TextBlock x:Name="NoticeText" Foreground="#F5F5F7" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
