diff --git a/browser/app/profile/firefox.js b/browser/app/profile/firefox.js
--- a/browser/app/profile/firefox.js
+++ b/browser/app/profile/firefox.js
@@ -3627,3 +3627,21 @@
 #ifdef XP_MACOSX
   pref("browser.macAppMenu.setAsDefaultShown", false);
 #endif
+
+// Still ARM64: prefer a smaller resident footprint over speculative work.
+// Fission and sandbox boundaries are unchanged; these are per-type/origin caps.
+pref("dom.ipc.processCount", 1);
+pref("dom.ipc.processCount.webIsolated", 1);
+pref("dom.ipc.keepProcessesAlive.privilegedabout", 0);
+pref("browser.cache.memory.capacity", 16384);
+pref("image.mem.surfacecache.max_size_kb", 128 * 1024);
+pref("browser.sessionhistory.max_total_viewers", 0);
+pref("network.prefetch-next", false);
+pref("network.dns.disablePrefetch", true);
+pref("network.http.speculative-parallel-limit", 0);
+pref("browser.urlbar.speculativeConnect.enabled", false);
+pref("browser.places.speculativeConnect.enabled", false);
+// Availability is a build capability, distinct from the user's enable switch.
+pref("still.memory.autoUnload.available", true, locked);
+pref("still.memory.autoUnload.enabled", true);
+pref("still.memory.autoUnload.inactiveMinutes", 5);
